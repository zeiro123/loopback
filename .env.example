# Loopback — local development configuration
# Copy to .env (docker compose reads its own environment from docker-compose.yml).

# ---- Bank target (Apex Trust Bank) ----
# Docker Compose default (container-to-container):
#   DATABASE_URL=postgres://postgres:12345678@db:5432/loopback
#   SOC_URL=http://soc:5100
# Local (bare node) default:
DATABASE_URL=postgres://postgres:12345678@localhost:5432/loopback
SOC_URL=http://localhost:5100
PORT=5000

# ---- Loopback SOC ----
SOC_DATABASE_URL=postgres://postgres:12345678@localhost:5432/soc
SOC_PORT=5100
